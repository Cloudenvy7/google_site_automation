# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Nothing in this file has a default in the code. That is deliberate: a default
# is how one client's index gets written into another client's catalogue.

# --- Google credentials -------------------------------------------------
# Path to YOUR service-account key. Never commit it.
# If unset, the code looks in ./service_account.json then
# ~/.advisor_os/service_account.json, and raises naming both if it finds neither.
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service_account.json

# --- The site being worked on -------------------------------------------
# The per-site Visual Knowledge Catalogue spreadsheet id (copied from the
# template -- see catalogue_template/). Required by the indexer's Pass B.
ADVISOR_CATALOGUE_ID=

# The Google Site id, from the editor URL:
#   https://sites.google.com/u/<N>/d/<THIS>/edit
ADVISOR_SITE_ID=

# Which signed-in Chrome profile the Site editor belongs to -- the <N> above.
# 0 is the first account signed in, 1 the second.
ADVISOR_U_INDEX=0

# --- Optional -----------------------------------------------------------
# Interpreter for subprocesses. Defaults to the running one, which is correct
# inside a venv.
# PYTHON=

# Chrome DevTools Protocol port. The launcher and the code both default to 9222.
# CHROME_PORT=9222
